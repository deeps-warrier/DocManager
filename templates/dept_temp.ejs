<div class="container mt-5">
  <div class="row justify-content-center">
    <div class="col-md-6">
      <div class="card shadow">
        <div class="card-body">
          <h2 class="card-title text-center mb-4" style="color: #1a819c; font-weight: 600">Add New Department</h2>

          <% if (locals.error) { %>
          <div class="alert alert-danger" role="alert"><%= error %></div>
          <% } %> <% if (locals.success) { %>
          <div class="alert alert-success" role="alert"><%= success %></div>
          <% } %>

          <form id="addDepartmentForm" class="needs-validation" novalidate>
            <div class="mb-3">
              <label for="name" class="form-label" style="color: #1a819c; font-weight: 600">Department Name</label>
              <input type="text" class="form-control" id="name" name="name" required minlength="2" maxlength="50" />
              <div class="invalid-feedback">Please enter a valid department name (2-50 characters)</div>
            </div>

            <div class="d-grid gap-2">
              <button type="submit" class="btn btn-primary" style="background-color: #1a819c; color: #fff; font-weight: 600">Add Department</button>
              <a href="/dashboard" class="btn btn-secondary"> Cancel </a>
            </div>
          </form>
        </div>
      </div>

      <!-- Departments List -->
      <div class="card mt-4 shadow">
        <div class="card-body">
          <h3 class="card-title h5 mb-3" style="color: #1a819c; font-weight: 600">Existing Departments</h3>
          <div id="departmentsList" class="list-group">
            <!-- Departments will be loaded here -->
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  document.addEventListener("DOMContentLoaded", function () {
    const form = document.getElementById("addDepartmentForm");
    const departmentsList = document.getElementById("departmentsList");

    // Load existing departments
    loadDepartments();

    // Form submission
    form.addEventListener("submit", async function (e) {
      e.preventDefault();

      if (!form.checkValidity()) {
        e.stopPropagation();
        form.classList.add("was-validated");
        return;
      }

      const name = document.getElementById("name").value;

      try {
        const response = await fetch("/departments", {
          method: "POST",
          headers: {
            "Content-Type": "application/json",
          },
          body: JSON.stringify({ name }),
        });

        const data = await response.json();

        if (response.ok) {
          // Show success message
          const alert = document.createElement("div");
          alert.className = "alert alert-success";
          alert.textContent = "Department added successfully";
          form.insertBefore(alert, form.firstChild);

          // Reset form
          form.reset();
          form.classList.remove("was-validated");

          // Reload departments list
          loadDepartments();

          // Remove success message after 3 seconds
          setTimeout(() => alert.remove(), 3000);
        } else {
          throw new Error(data.error || "Error adding department");
        }
      } catch (error) {
        const alert = document.createElement("div");
        alert.className = "alert alert-danger";
        alert.textContent = error.message;
        form.insertBefore(alert, form.firstChild);
      }
    });

    // Load departments function
    async function loadDepartments() {
      try {
        const response = await fetch("/departments");
        const departments = await response.json();

        departmentsList.innerHTML = departments.length
          ? departments
              .map(
                (dept) => `
                <div class="list-group-item d-flex justify-content-between align-items-center">
                    <div>
                        ${dept.name}
                        <span class="badge text-dark bg-warning rounded-pill ms-2">
                            ${new Date(dept.createdAt).toLocaleDateString()}
                        </span>
                    </div>
                    <button 
                        class="btn btn-sm btn-outline-danger"
                        onclick="deleteDepartment('${dept._id}', '${dept.name}')"
                    >
                        <i class="bi bi-trash"></i>
                    </button>
                </div>
            `
              )
              .join("")
          : '<div class="list-group-item text-muted">No departments found</div>';
      } catch (error) {
        departmentsList.innerHTML = `
            <div class="alert alert-danger mb-0">
                Error loading departments
            </div>
        `;
      }
    }

    window.deleteDepartment = async function (deptId, deptName) {
      if (!confirm(`Are you sure you want to delete department "${deptName}"? This will affect all users and documents in this department.`)) {
        return;
      }

      try {
        const response = await fetch(`/departments/${deptId}`, {
          method: "DELETE",
        });

        if (!response.ok) {
          const data = await response.json();
          throw new Error(data.error || "Error deleting department");
        }

        // Show success message
        const alert = document.createElement("div");
        alert.className = "alert alert-success alert-dismissible fade show mt-3";
        alert.innerHTML = `
              Department "${deptName}" has been deleted successfully
              <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
          `;
        departmentsList.parentNode.insertBefore(alert, departmentsList);

        // Reload the departments list
        await loadDepartments();

        // Remove the alert after 3 seconds
        setTimeout(() => alert.remove(), 3000);
      } catch (error) {
        console.error("Error:", error);
        alert(error.message);
      }
    };
  });
</script>
