<div class="container-fluid py-4">
  <!-- Welcome Section -->
  <div class="row mb-4">
    <div class="col-12">
      <h2 style="font-family: Arial, Helvetica, sans-serif; color: #1a819c; font-weight: 600">Welcome, <%= user.username %></h2>
      <% if (user.department) { %>
      <p style="font-family: Arial, Helvetica, sans-serif; color: #1a819c; font-weight: 600">Department: <%= user.department?.name %></p>
      <% } %>
    </div>
  </div>

  <!-- Documents Section -->
  <div class="row mb-4">
    <div class="col-12">
      <div class="card">
        <div class="card-header d-flex justify-content-between align-items-center">
          <h5 class="mb-0">Documents</h5>
          <div style="display: flex; column-gap: 10px; align-items: center">
            <div class="search-container">
              <input type="text" id="searchDocs" class="form-control" placeholder="Search documents..." style="min-width: 250px" />
            </div>
            <% if (user.role === 'admin') { %>
            <button class="btn" data-bs-toggle="modal" data-bs-target="#uploadModal" style="background-color: #1a819c; color: #fff; font-weight: 600"><i class="bi bi-upload"></i> Upload New</button>
            <% } %>
          </div>
        </div>

        <div class="card-body border-bottom pb-3">
          <div class="d-flex flex-wrap gap-2" id="categoryFilters">
        
            <!-- All Documents - default -->
            <span
              class="badge category-filter active"
              data-category="all"
              style="cursor:pointer; background-color:#1a819c; font-size:0.9rem; padding:8px 15px;">
              All Documents
            </span>
        
            <!-- Categories will be loaded automatically -->
            
          </div>
        </div>

        <div class="card-body">
          <div class="row row-cols-1 row-cols-md-3 row-cols-lg-4 g-5">
            <% documents.forEach(function(doc) { %>
            <div class="col" data-category="<%= doc.category ? doc.category._id : '' %>">
              <div class="card h-100 shadow-sm">

                <div class="card-body">
                  <div class="text-center mb-3">
                    <i class="bi bi-file-pdf text-danger" style="font-size: 2rem"></i>
                  </div>

<span class="badge doc_cat mb-2"
      style="background-color:#1a819c;
             font-size:0.7rem;
             padding:6px 12px;
             display:inline-block;
             white-space:normal;
             word-break:break-word;
             box-sizing:border-box;
             max-width:100%;
             text-align:left;">
  <%= doc.category?.name %>
</span>

                  <h6 class="card-title" title="<%= doc.files[0]?.originalname %>">
                    <%= doc.files[0].originalname %>
                  </h6>

                  <p class="card-text small mb-1" style="color: #1a819c; font-weight: 600">
                    Department: <%= doc.department.name %>
                  </p>
                </div>

                <div class="card-footer bg-transparent border-top-0">
                  <div class="d-flex justify-content-between">
                    <a href="/docs/view/<%= doc._id %>" class="btn btn-sm btn-warning">
                      <i class="bi bi-eye"></i> View
                    </a>

                    <% if (user.role === 'admin' || doc.uploadedBy.equals(user._id)) { %>
                    <button class="btn btn-sm btn-outline-danger" onclick="deleteDocument('<%= doc._id %>')">
                      <i class="bi bi-trash"></i>
                    </button>
                    <% } %>
                  </div>
                </div>

              </div>
            </div>
            <% }); %>
          </div>
        </div>

      </div>
    </div>
  </div>
</div>

<!-- FOOTER -->
<footer class="dashboard-footer mt-5">
  <div class="container-fluid">
    <div class="row align-items-center">
      
      <div class="col-md-6 text-center text-md-start">
        © <%= new Date().getFullYear() %> Document Management System
      </div>

      <div class="col-md-6 text-center text-md-end">
        Developed by Deepswarrier
      </div>

    </div>
  </div>
</footer>

<!-- Upload Modal -->
<div class="modal fade" id="uploadModal" tabindex="-1">
  <div class="modal-dialog">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title">Upload New Document</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>

      <div class="modal-body">
        <form action="/upload" method="POST" enctype="multipart/form-data" class="needs-validation" novalidate>

          <div class="mb-3">
            <label class="form-label">Department</label>
            <select class="form-control" id="department" name="department" required>
              <option value="">Select Department</option>
            </select>
            <div class="invalid-feedback">Please select a department</div>
          </div>

          <div class="mb-3">
            <label class="form-label">Category</label>
            <select class="form-control" id="category" name="category" required>
              <option value="">Select Category</option>
            </select>
            <div class="invalid-feedback">Please select a category</div>
          </div>

          <div class="mb-3">
            <label class="form-label">Select PDF Files (Max 5)</label>
            <input type="file" class="form-control" id="documents" name="documents" accept=".pdf" multiple required />
            <div class="form-text">You can select up to 5 PDF files.</div>
            <div class="invalid-feedback">Please select at least one PDF file</div>
          </div>

          <div class="text-end">
            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
            <button type="submit" class="btn" style="background-color:#1a819c;color:#fff;font-weight:600">
              Upload Files
            </button>
          </div>

        </form>
      </div>
    </div>
  </div>
</div>

<!-- Scripts -->
<script>

// ============================================================
// LOAD CATEGORIES FOR UPLOAD + CATEGORY FILTERS
// ============================================================

async function loadCategories() {

  try {

    const response = await fetch("/categories");

    if (!response.ok) {
      throw new Error("Failed to load categories");
    }

    const categories = await response.json();

    // --------------------------------------------------------
    // 1. LOAD CATEGORY FILTER BUTTONS
    // --------------------------------------------------------

    const categoryFilters = document.getElementById("categoryFilters");

    // Keep All Documents button
    categoryFilters.innerHTML = `
      <span
        class="badge category-filter active"
        data-category="all"
        style="
          cursor:pointer;
          background-color:#1a819c;
          font-size:0.9rem;
          padding:8px 15px;
        ">
        All Documents
      </span>
    `;

    // Add every category from database
    categories.forEach((cat) => {

      const categoryButton = document.createElement("span");

      categoryButton.className = "badge category-filter";

      categoryButton.setAttribute("data-category", cat._id);

      categoryButton.style.cursor = "pointer";
      categoryButton.style.backgroundColor = "#1a819c";
      categoryButton.style.fontSize = "0.9rem";
      categoryButton.style.padding = "8px 15px";

      categoryButton.textContent = cat.name;

      categoryFilters.appendChild(categoryButton);

    });


    // --------------------------------------------------------
    // 2. CATEGORY FILTER CLICK
    // --------------------------------------------------------

    document.querySelectorAll(".category-filter").forEach((button) => {

      button.addEventListener("click", function () {

        const selectedCategory = this.getAttribute("data-category");

        // Remove active from all buttons
        document.querySelectorAll(".category-filter").forEach((btn) => {
          btn.classList.remove("active");
        });

        // Make clicked button active
        this.classList.add("active");

        // Get all document cards
        const documents = document.querySelectorAll(
          ".row.row-cols-1.row-cols-md-3.row-cols-lg-4.g-5 > .col"
        );

        documents.forEach((doc) => {

          const documentCategory = doc.getAttribute("data-category");

          if (
            selectedCategory === "all" ||
            documentCategory === selectedCategory
          ) {

            doc.style.display = "";

          } else {

            doc.style.display = "none";

          }

        });

      });

    });

  } catch (error) {

    console.error("Error loading categories:", error);

  }

}


// ============================================================
// UPLOAD MODAL
// ============================================================

document.getElementById("uploadModal").addEventListener(
  "show.bs.modal",
  async function () {

    try {

      // ------------------------------------------------------
      // LOAD DEPARTMENTS
      // ------------------------------------------------------

      const response = await fetch("/departments");

      const departments = await response.json();

      const departmentSelect =
        document.getElementById("department");

      departmentSelect.innerHTML =
        '<option value="">Select Department</option>';

      departments.forEach((dept) => {

        const option = document.createElement("option");

        option.value = dept._id;

        option.textContent = dept.name;

        departmentSelect.appendChild(option);

      });


      // Select user's department automatically
      const userDepartment = "<%= user.department?._id || '' %>";

      if (userDepartment) {

        departmentSelect.value = userDepartment;

      }


      // ------------------------------------------------------
      // LOAD CATEGORIES IN UPLOAD DROPDOWN
      // ------------------------------------------------------

      const catresponse = await fetch("/categories");

      const categories = await catresponse.json();

      const CategorySelect =
        document.getElementById("category");

      CategorySelect.innerHTML =
        '<option value="">Select Category</option>';

      categories.forEach((cat) => {

        const option = document.createElement("option");

        option.value = cat._id;

        option.textContent = cat.name;

        CategorySelect.appendChild(option);

      });

    } catch (error) {

      console.error("Error fetching details:", error);

      alert("Error loading details. Please try again.");

    }

  }
);


// ============================================================
// DELETE DOCUMENT
// ============================================================

async function deleteDocument(docId) {

  if (!confirm("Are you sure you want to delete this document?")) {
    return;
  }

  try {

    const response = await fetch(
      `/documents/${docId}`,
      {
        method: "DELETE"
      }
    );

    if (response.ok) {

      window.location.reload();

    } else {

      const data = await response.json();

      alert(
        data.error ||
        "Error deleting document"
      );

    }

  } catch (error) {

    console.error("Error:", error);

    alert("Error deleting document");

  }

}


// ============================================================
// INITIAL LOAD
// ============================================================

// Load category buttons immediately when Dashboard opens
document.addEventListener("DOMContentLoaded", function () {

  loadCategories();

});

</script>

